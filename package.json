{
  "name": "fictional-browser",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "node build.js"
  },
  "build": {
    "appId": "com.fictional.browser",
    "productName": "Fictional Browser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "renderer.js",
      "browser.html",
      "styles.css",
      "webview-preload.js",
      "registry.json"
    ],
    "win": {
      "target": "portable"
    }
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^25.0.0"
  }
}